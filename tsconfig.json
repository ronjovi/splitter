{
  "compilerOptions": {
    "jsx": "react",
    "declaration": true,
    "declarationDir": "lib/types",
    "emitDeclarationOnly": false,
    "module": "ESNext",
    "target": "ES2017",
    "lib": ["dom", "ES2017"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src"
  },
  "include": ["src"]
}
